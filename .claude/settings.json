{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(dotnet build*)",
      "Bash(dotnet restore*)",
      "Bash(dotnet test*)",
      "Bash(dotnet run*)",
      "Bash(dotnet publish*)",
      "Bash(dotnet ef migrations add*)",
      "Bash(dotnet ef migrations list*)",
      "Bash(dotnet ef migrations script*)",
      "Bash(dotnet user-secrets*)",
      "Bash(dotnet format*)",
      "Bash(ng build*)",
      "Bash(ng test*)",
      "Bash(ng lint*)",
      "Bash(ng serve*)",
      "Bash(ng generate*)",
      "Bash(ng new*)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npm run*)",
      "Bash(npx *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git stash*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(mkdir*)",
      "Bash(ls*)",
      "Bash(sqllocaldb*)",
      "Bash(azurite*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "statusMessage": "Updating phase reports index...",
            "command": "powershell -NonInteractive -File .claude/scripts/update-phase-index.ps1",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "statusMessage": "Checking docs for milestone updates...",
            "command": "powershell -NonInteractive -File .claude/scripts/docs-update-check.ps1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "statusMessage": "Test gate: verifying tests pass before commit...",
            "command": "$raw=[Console]::In.ReadToEnd();if($raw -notmatch 'git commit'){exit 0};if(-not(Test-Path *.sln)){exit 0};Write-Host 'TEST GATE: Running dotnet test...';dotnet test --nologo;if($LASTEXITCODE -ne 0){@{decision='block';reason='Tests failed - commit blocked. Fix all failing tests before committing.'} | ConvertTo-Json -Compress;exit 2};exit 0"
          }
        ]
      }
    ]
  }
}
